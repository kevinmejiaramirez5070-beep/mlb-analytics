# Configuración de la base de datos
# Para MySQL (local):
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=mlbb

# Para PostgreSQL/Supabase:
DB_TYPE=postgres
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=postgres
