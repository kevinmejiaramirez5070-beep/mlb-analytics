# Configuración del servidor
PORT=5000
NODE_ENV=development

# Configuración del frontend
FRONTEND_URL=http://localhost:3000

# Configuración de la API de MLB
MLB_API_TIMEOUT=10000
MLB_CACHE_TIMEOUT=300000


